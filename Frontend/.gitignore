# /Frontend/.gitignore

# Dependências (O equivalente ao bin/obj do .NET)
node_modules/

# IDE e Editor (VS Code)
.vscode/*
!.vscode/extensions.json
.history/
*.code-workspace

# Ferramentas de IA e Agentes (Antigravity, Copilot, etc.)
.antigravity/
.antigravity.*
.copilot/
*.agignore

# Logs de erro (Incluindo os gerados pelo Bun)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-error.log*

# Arquivos de ambiente locais (Segredos e chaves de API)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Pastas de build final geradas pelo Vite para produção
dist/
dist-ssr/
*.local

# Caches e artefatos de compilação do TypeScript/ESLint
.eslintcache
.tsbuildinfo